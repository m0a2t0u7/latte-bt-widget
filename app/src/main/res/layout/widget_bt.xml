<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp" android:paddingVertical="2dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/icon" android:padding="2dp" android:background="@drawable/widget_label_glass" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_bt"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/status" android:paddingHorizontal="2dp" android:background="@drawable/widget_label_glass" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="読み込み中" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/device" android:paddingHorizontal="2dp" android:background="@drawable/widget_label_glass" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFFFFF" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/btn_switch" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginEnd="6dp"
        android:text="切替" android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/btn_gray_rect"/>
    <TextView android:id="@+id/btn_main" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:text="切断" android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/btn_widget_action"/>
</LinearLayout>
