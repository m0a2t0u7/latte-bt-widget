<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="6dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/icon" android:padding="2dp" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_bt" android:tint="@color/widget_ink"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/status" android:paddingHorizontal="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textColor="@color/widget_ink" android:text=""/>
        <TextView android:id="@+id/device" android:paddingHorizontal="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:text=""/>
    </LinearLayout>
    <TextView android:id="@+id/btn_main" android:layout_width="43dp" android:layout_height="29dp" android:gravity="center" android:paddingHorizontal="3dp"
        android:text="切断" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp"
        android:textColor="@color/widget_ink" android:background="@drawable/btn_widget_action"/>
</LinearLayout>
