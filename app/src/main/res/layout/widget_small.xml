<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="4dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/icon" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_bt"/>
    <TextView android:id="@+id/device" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F2F2F2" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:text=""/>
</LinearLayout>
