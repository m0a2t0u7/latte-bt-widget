<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#71364D65" android:centerColor="#5141546C" android:endColor="#66383C63"/>
            <stroke android:width="1dp" android:color="#A3AACAE4"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="2dp"
        android:left="9dp" android:top="1dp" android:right="9dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00FFFFFF"
                android:centerColor="#F0FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="2dp"
        android:left="9dp" android:right="9dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="0" android:startColor="#C279B8E5"
                android:centerColor="#3DD4EBFF" android:endColor="#D19B81DE"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
