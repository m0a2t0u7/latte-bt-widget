<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#A525334A"
                android:centerColor="#AA19263E" android:endColor="#BD141E33"/>
            <stroke android:width="1dp" android:color="#99DDEEFF"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="2dp"
        android:left="5dp" android:top="1dp" android:right="5dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00FFFFFF"
                android:centerColor="#F2FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="2dp"
        android:left="5dp" android:right="5dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="0" android:startColor="#007AD8FF"
                android:centerColor="#C07AD8FF" android:endColor="#008E82FF"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
