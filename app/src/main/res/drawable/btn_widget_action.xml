<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape>
            <solid android:color="#265D6B8C"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape>
            <gradient android:angle="270" android:startColor="#E8FFFFFF" android:endColor="#C9E6EDF8"/>
            <stroke android:width="1dp" android:color="#E4FFFFFF"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
