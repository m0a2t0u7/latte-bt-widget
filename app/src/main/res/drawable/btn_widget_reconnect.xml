<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape>
            <solid android:color="#36665991"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape>
            <gradient android:angle="270" android:startColor="#E8F8F4FF" android:endColor="#CCD8D0F6"/>
            <stroke android:width="1dp" android:color="#E4FFFFFF"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
