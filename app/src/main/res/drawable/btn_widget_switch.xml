<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape>
            <solid android:color="#225D6B8C"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape>
            <gradient android:angle="270" android:startColor="#D4FBFCFF" android:endColor="#ADDDE7F6"/>
            <stroke android:width="1dp" android:color="#BCFFFFFF"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
